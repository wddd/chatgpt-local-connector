{
  "name": "arc-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "Registry"
      },
      {
        "name": "INSTANCES",
        "class_name": "Instance"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Registry",
        "Instance"
      ]
    }
  ],
  "vars": {
    "ARC_VERSION": "development"
  },
  "compatibility_flags": [
    "enable_request_signal",
    "request_signal_passthrough"
  ]
}
